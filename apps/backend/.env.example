# Supabase Postgres — usar la conexion directa (no el pooler transaccional
# de PgBouncer), porque este backend mantiene su propio pool de asyncpg de
# larga duracion. En el dashboard de Supabase / Vercel es POSTGRES_URL_NON_POOLING.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# IA de vision (extraccion de guias)
OPENAI_API_KEY=sk-proj-...
VISION_MODEL=gpt-5.6-luna

# Supabase Storage (evidencia) — solo para scripts/setup_storage.py
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# CORS
DASHBOARD_ORIGIN=http://localhost:3000
